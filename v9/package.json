{
  "name": "afterglow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A chalk-drawn harbor mystery",
  "author": "Sweet Papa Technologies",
  "main": "desktop.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "playtest": "playwright test",
    "check": "npm test && npm run assets && npm run build",
    "assets": "node scripts/check-assets.js",
    "desktop": "npm run build && electron .",
    "package": "npm run check && electron-builder",
    "size": "node scripts/size.js",
    "format": "prettier --write src tests scripts *.js *.cjs *.json"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "electron": "38.1.2",
    "electron-builder": "26.0.12",
    "vite": "7.1.7",
    "three": "0.180.0",
    "prettier": "3.6.2"
  },
  "build": {
    "appId": "com.sweetpapa.afterglow",
    "productName": "AFTERGLOW",
    "files": [
      "dist/**/*",
      "desktop.cjs",
      "package.json",
      "preload.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.adventure-games"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
